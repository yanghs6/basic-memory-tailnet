#!/usr/bin/env bash
# Test stub for ssh: logs the call, then runs the remote command locally so other stubs on PATH
# act as the VM. SSH_STUB_FAIL_MATCH=<substring> makes matching remote commands fail with 255.
# A tunnel (-N) runs no remote command: SSH_STUB_TUNNEL_EXIT=<n> ends it at once with n (forwarding failed);
# otherwise it records its pid in $STUB_LOG.tunnel-pids and stays up like an open tunnel until it is killed (with its output closed).
set -euo pipefail
printf 'ssh %s\n' "$*" >>"$STUB_LOG"
for arg in "$@"; do
  if [[ "$arg" == -N ]]; then
    if [[ -n "${SSH_STUB_TUNNEL_EXIT:-}" ]]; then
      exit "$SSH_STUB_TUNNEL_EXIT"
    fi
    echo "$$" >>"$STUB_LOG.tunnel-pids"
    # Detached from the caller's pipes, so a leaked tunnel cannot keep a bats `run` waiting.
    exec sleep 300 >/dev/null 2>&1
  fi
done
remote_cmd="${*: -1}"
if [[ -n "${SSH_STUB_FAIL_MATCH:-}" && "$remote_cmd" == *"$SSH_STUB_FAIL_MATCH"* ]]; then
  echo "ssh stub: simulated failure for: $remote_cmd" >&2
  exit 255
fi
exec bash -c "$remote_cmd"
