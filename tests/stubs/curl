#!/usr/bin/env bash
# Test stub for curl.
# MCP mode (CURL_FIXTURES set): answers JSON-RPC requests from fixture files named after the method:
#   initialize, notifications_initialized, tools_list, call_<tool> (.body and optional .status).
#   Request payloads are appended to $STUB_LOG.requests. CURL_STUB_EXIT=<n> simulates a transport error.
#   A request with an id gets an answer with that id: each "id":<number> in the body becomes it (an escaped \"id\": stays).
# SilverBullet mode (URL path /.ping, /.fs/..., /.auth, /.shell or /.logout): answers like a server with a login and
#   the shell off; see sb_response for the overrides.
# Web mode (CURL_WEB_FIXTURES set): answers from <name>.status (default 200), <name>.headers and <name>.body in that
#   directory, where <name> is the URL path without its leading / and . and with each / turned into _ (for example
#   /.well-known/oauth-authorization-server -> well-known_oauth-authorization-server). -d payloads are appended to
#   $STUB_LOG.requests. With CURL_WEB_HOST set, only URLs containing it are answered this way (MCP mode can run beside it).
# Download mode: writes "stub" to the -o file, or prints $CURL_STUB_SCRIPT (default "true") for `curl | sh`; with
#   -w '%{http_code}' it also prints CURL_STUB_HTTP_CODE (default 200), like a reachability probe.
# CURL_STUB_FAIL_MATCH=<substring>: calls whose arguments contain it fail with CURL_STUB_FAIL_EXIT (default 28 =
#   timeout; 6 = DNS), like a network that blocks that host.
# CURL_STUB_CONFLICT_MATCH=<substring> (MCP mode): a write_note request whose payload contains it is answered with action
#   conflict instead of created (an answered failure, unlike CURL_STUB_FAIL_MATCH).
set -euo pipefail
printf 'curl %s\n' "$*" >>"$STUB_LOG"
if [[ -n "${CURL_STUB_FAIL_MATCH:-}" && "$*" == *"$CURL_STUB_FAIL_MATCH"* ]]; then
  echo "curl: (${CURL_STUB_FAIL_EXIT:-28}) simulated failure (stub)" >&2
  exit "${CURL_STUB_FAIL_EXIT:-28}"
fi
wants_code=""
if [[ "$*" == *'%{http_code}'* ]]; then
  wants_code=1
fi

headers_file=""
body_file=""
data=""
cookie_jar=""
url=""

# sb_response -> print the status code and write the headers and body of a SilverBullet answer. Overrides:
# CURL_SB_{PING,FS,FONT,AUTH,SHELL}_STATUS, CURL_SB_AUTH_BODY and CURL_SB_COOKIE (the login's Set-Cookie line, empty for
# none). The login's stdin (the password) is appended to $STUB_LOG.stdin.
sb_response() {
  local status=200 body="" headers=""
  local ok_body='{"status":"ok","redirect":"/"}'
  local cookie_line='set-cookie: auth_agent-hub=stub-session-token; Path=/; Max-Age=604800; SameSite=Lax; HttpOnly'
  case "$url" in
    */.ping) status="${CURL_SB_PING_STATUS:-200}" ;;
    */.fs/Library/agent-hub/fonts/*) status="${CURL_SB_FONT_STATUS:-200}" ;;
    */.fs/*) status="${CURL_SB_FS_STATUS:-401}" ;;
    */.shell) status="${CURL_SB_SHELL_STATUS:-405}" ;;
    */.logout) status=302 ;;
    */.auth)
      cat >>"$STUB_LOG.stdin"
      status="${CURL_SB_AUTH_STATUS:-200}"
      body="${CURL_SB_AUTH_BODY-$ok_body}"
      headers="${CURL_SB_COOKIE-$cookie_line}"
      if [[ -n "$headers" && -n "$cookie_jar" ]]; then
        echo "stub-jar" >"$cookie_jar"
      fi
      ;;
  esac
  if [[ -n "$headers_file" ]]; then
    printf 'HTTP/1.1 %s\r\n%s\r\n\r\n' "$status" "$headers" >"$headers_file"
  fi
  if [[ -n "$body_file" ]]; then
    printf '%s' "$body" >"$body_file"
  fi
  printf '%s' "$status"
}

while (($#)); do
  case "$1" in
    -c)
      cookie_jar="$2"
      shift 2
      ;;
    http://* | https://*)
      url="$1"
      shift
      ;;
    -D)
      headers_file="$2"
      shift 2
      ;;
    -o)
      body_file="$2"
      shift 2
      ;;
    -d)
      data="$2"
      shift 2
      ;;
    *) shift ;;
  esac
done

case "$url" in
  */.ping | */.fs/* | */.auth | */.shell | */.logout)
    sb_response
    exit 0
    ;;
esac

# web_response -> print the status code and copy the headers and body fixtures of the URL path (see Web mode above).
web_response() {
  local name="${url#*://}"
  name="${name#*/}"
  name="${name#.}"
  name="${name//\//_}"
  if [[ -n "$data" ]]; then
    printf '%s\n' "$data" >>"$STUB_LOG.requests"
  fi
  if [[ -n "$headers_file" ]]; then
    if [[ -f "$CURL_WEB_FIXTURES/$name.headers" ]]; then
      cp "$CURL_WEB_FIXTURES/$name.headers" "$headers_file"
    else
      : >"$headers_file"
    fi
  fi
  if [[ -n "$body_file" ]]; then
    if [[ -f "$CURL_WEB_FIXTURES/$name.body" ]]; then
      cp "$CURL_WEB_FIXTURES/$name.body" "$body_file"
    else
      : >"$body_file"
    fi
  fi
  if [[ -f "$CURL_WEB_FIXTURES/$name.status" ]]; then
    tr -d '\n' <"$CURL_WEB_FIXTURES/$name.status"
  else
    printf '200'
  fi
}

if [[ -n "${CURL_WEB_FIXTURES:-}" && (-z "${CURL_WEB_HOST:-}" || "$url" == *"$CURL_WEB_HOST"*) ]]; then
  web_response
  exit 0
fi

if [[ -z "${CURL_FIXTURES:-}" ]]; then
  if [[ -n "$body_file" ]]; then
    echo stub >"$body_file"
    if [[ -n "$wants_code" ]]; then
      printf '%s' "${CURL_STUB_HTTP_CODE:-200}"
    fi
  else
    printf '%s\n' "${CURL_STUB_SCRIPT:-true}"
  fi
  exit 0
fi

if [[ -n "${CURL_STUB_EXIT:-}" ]]; then
  echo "curl: (7) Failed to connect (stub)" >&2
  exit "$CURL_STUB_EXIT"
fi

printf '%s\n' "$data" >>"$STUB_LOG.requests"
key="$(jq -r 'if .method == "tools/call" then "call_" + .params.name else (.method | gsub("/"; "_")) end' <<<"$data")"
if [[ -n "$headers_file" ]]; then
  cp "$CURL_FIXTURES/headers.txt" "$headers_file"
fi
request_id="$(jq -r '.id // empty' <<<"$data")"
if [[ "$key" == call_write_note && -n "${CURL_STUB_CONFLICT_MATCH:-}" && "$data" == *"$CURL_STUB_CONFLICT_MATCH"* ]]; then
  sed -E 's/(^|[^\\])"id":[0-9]+/\1"id":'"$request_id"'/g; s/\\"action\\":\\"created\\"/\\"action\\":\\"conflict\\"/; s/"action":"created"/"action":"conflict"/' \
    "$CURL_FIXTURES/$key.body" >"$body_file"
elif [[ -f "$CURL_FIXTURES/$key.body" && -n "$request_id" ]]; then
  sed -E 's/(^|[^\\])"id":[0-9]+/\1"id":'"$request_id"'/g' "$CURL_FIXTURES/$key.body" >"$body_file"
elif [[ -f "$CURL_FIXTURES/$key.body" ]]; then
  cp "$CURL_FIXTURES/$key.body" "$body_file"
else
  : >"$body_file"
fi
if [[ -f "$CURL_FIXTURES/$key.status" ]]; then
  tr -d '\n' <"$CURL_FIXTURES/$key.status"
else
  printf '200'
fi
