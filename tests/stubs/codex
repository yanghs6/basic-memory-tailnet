#!/usr/bin/env bash
# Test stub for codex: logs "codex <args> :: cwd=<dir>". With -o FILE it writes a plan review to FILE,
# otherwise it prints a diff review. CODEX_STUB_EXIT=<n> makes every call fail;
# CODEX_STUB_PLAN_EXIT=<n> makes only the plan review (the call with -o) fail.
# STUB_LOG_STDIN=1 also logs "codex stdin_bytes=<n>", the bytes it read from stdin.
# CODEX_STUB_FINDING=1 adds the line "[P2] <cwd>/scripts/x.sh:12 - finding" to either review, as codex names files by
# absolute path.
set -euo pipefail
printf 'codex %s :: cwd=%s\n' "$*" "$PWD" >>"$STUB_LOG"
if [[ "${STUB_LOG_STDIN:-}" == 1 ]]; then
  printf 'codex stdin_bytes=%s\n' "$(wc -c | tr -d ' ')" >>"$STUB_LOG"
fi
if [[ -n "${CODEX_STUB_EXIT:-}" ]]; then
  echo "codex stub: simulated failure" >&2
  exit "$CODEX_STUB_EXIT"
fi
out=""
while (($#)); do
  case "$1" in
    -o)
      out="$2"
      shift 2
      ;;
    *) shift ;;
  esac
done
if [[ -n "$out" && -n "${CODEX_STUB_PLAN_EXIT:-}" ]]; then
  echo "codex stub: simulated plan review failure" >&2
  exit "$CODEX_STUB_PLAN_EXIT"
fi
report="codex diff review"
if [[ -n "$out" ]]; then
  report="codex plan review"
fi
if [[ "${CODEX_STUB_FINDING:-}" == 1 ]]; then
  report="$report
[P2] $PWD/scripts/x.sh:12 - finding"
fi
if [[ -n "$out" ]]; then
  printf '%s\n' "$report" >"$out"
else
  printf '%s\n' "$report"
fi
