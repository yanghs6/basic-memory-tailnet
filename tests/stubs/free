#!/usr/bin/env bash
# Test stub for free -m: 3900 MB RAM with FREE_STUB_AVAILABLE_MB available (default 3000 -> 23% used) and
# FREE_STUB_SWAP_TOTAL_MB of swap (default 1023, all free).
set -euo pipefail
printf 'free %s\n' "$*" >>"$STUB_LOG"
swap_total="${FREE_STUB_SWAP_TOTAL_MB:-1023}"
printf '               total        used        free      shared  buff/cache   available\n'
printf 'Mem:            3900         700        2200           5        1000        %s\n' "${FREE_STUB_AVAILABLE_MB:-3000}"
printf 'Swap:     %10s  %10s  %10s\n' "$swap_total" 0 "$swap_total"
