#!/usr/bin/env bash
# Test stub for sudo: drops leading options (-n, and -u with its user) and runs the rest with env
# (handles VAR=value cmd), as the current user.
set -euo pipefail
printf 'sudo %s\n' "$*" >>"$STUB_LOG"
while [[ "${1:-}" == -* ]]; do
  if [[ "$1" == -u ]]; then
    shift
  fi
  shift
done
exec env "$@"
