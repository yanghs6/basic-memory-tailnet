# Copy to .env (git-ignored) and fill in. No secrets belong here.
# Write values without quotes or spaces: make reads them literally.

# Access mode, one per VM: tailscale (tailnet + Serve) or ssh (SSH host alias + make tunnel). Empty means tailscale.
# Run make access-check on every network your clients use, then choose (docs/runbooks/bootstrap.md)
BM_ACCESS=

# tailscale mode: Tailscale machine name of the VM (MagicDNS short name); ssh mode: the Host alias in ~/.ssh/config
BM_VM_HOST=agent-hub
# SSH user on the VM (Canonical Ubuntu images use ubuntu)
BM_VM_USER=ubuntu
# tailscale mode only: your tailnet DNS name, e.g. tail1234.ts.net (admin console > DNS); no https:// and no trailing dot
BM_TAILNET_DOMAIN=
# Required by make verify/probe: VM public IPv4; verify checks that ports 22, 80, 443 and BM_PORT are closed from outside
# The address usually changes after the VM is stopped and started: update it then
BM_VM_PUBLIC_IP=
# Loopback port Basic Memory listens on (local and VM)
BM_PORT=8737
# Loopback port SilverBullet (the web UI) listens on (local and VM)
SB_PORT=3000
# SilverBullet login as <user>:<password>; make local-up, deploy, restore and verify need it.
# This one is a secret: fill it in only in the main checkout .env (git-ignored), never here or in a commit.
# Use letters, digits and ._~+/=- only: make reads this file literally (# starts a comment, $ expands).
# A password that fits: openssl rand -base64 24
SB_USER=

# make access-check: the ssh mode's tunnel endpoint (this one is GCP IAP's; docs/runbooks/gcp-vm.md, section 8)
BM_ACCESS_CHECK_URL=https://tunnel.cloudproxy.app/
# ssh mode: local ports make tunnel opens on 127.0.0.1 for MCP and the web UI
BM_TUNNEL_MCP_PORT=18737
BM_TUNNEL_WEB_PORT=13000
