# Copy to .env (git-ignored) and fill in. No secrets belong here.
# Write values without quotes or spaces: make reads them literally.

# Access mode, one per VM: tailscale (tailnet + Serve) or ssh (SSH host alias + make tunnel). Empty means tailscale.
# Run make access-check on every network your clients use, then choose (docs/runbooks/rbk-2026-10-12-ha5w72pm-bootstrap.md)
BM_ACCESS=

# tailscale mode: Tailscale machine name of the VM (MagicDNS short name); ssh mode: the Host alias in ~/.ssh/config
BM_VM_HOST=agent-hub
# SSH user on the VM (Canonical Ubuntu images use ubuntu)
BM_VM_USER=ubuntu
# tailscale mode only: your tailnet DNS name, e.g. tail1234.ts.net (admin console > DNS); no https:// and no trailing dot
BM_TAILNET_DOMAIN=
# Required by make verify/probe: VM public IPv4; verify checks that ports 22, 80, 443 and BM_PORT are closed from outside
# The address usually changes after the VM is stopped and started: update it then
BM_VM_PUBLIC_IP=
# Loopback port Basic Memory listens on (local and VM)
BM_PORT=8737
# Loopback port SilverBullet (the web UI) listens on (local and VM)
SB_PORT=3000
# SilverBullet login as <user>:<password>; make local-up, deploy, restore and verify need it.
# This one is a secret: fill it in only in the main checkout .env (git-ignored), never here or in a commit.
# Use letters, digits and ._~+/=- only: make reads this file literally (# starts a comment, $ expands).
# A password that fits: openssl rand -base64 24
SB_USER=

# make access-check: the ssh mode's tunnel endpoint (this one is GCP IAP's; docs/runbooks/rbk-2026-10-12-tcjs7m6x-gcp-vm.md, section 8)
BM_ACCESS_CHECK_URL=https://tunnel.cloudproxy.app/
# ssh mode: local ports make tunnel opens on 127.0.0.1 for MCP and the web UI
BM_TUNNEL_MCP_PORT=18737
BM_TUNNEL_WEB_PORT=13000

# Optional claude.ai web connector (an OAuth gateway behind a Cloudflare tunnel): on or off. Empty means off.
# With on, make deploy and restore need every BM_WEB_* value below (docs/specs/spec-2026-10-22-tn23wwmd-web-connector.md, section 3.3).
BM_WEB=
# Public host name of the connector, without https:// (for example mcp.<domain>); a Cloudflare tunnel public hostname
BM_WEB_HOST=
# Loopback port the gateway listens on (local and VM)
BM_WEB_PORT=8738
# Numeric GitHub user id of the one account allowed in: gh api users/<login> --jq .id
BM_WEB_GITHUB_USER_ID=
# Client ID of the GitHub OAuth App
BM_WEB_GITHUB_CLIENT_ID=
# The three secrets below belong only in the main checkout .env (git-ignored), never here or in a commit.
# Use letters, digits and ._~+/=- only: make reads this file literally (# starts a comment, $ expands).
# Client secret of the GitHub OAuth App
BM_WEB_GITHUB_CLIENT_SECRET=
# Signs the gateway tokens and encrypts its store, at least 32 characters; changing it invalidates every registration.
# One that fits: openssl rand -hex 32
BM_WEB_JWT_KEY=
# Token of the Cloudflare remotely managed tunnel
BM_WEB_TUNNEL_TOKEN=
